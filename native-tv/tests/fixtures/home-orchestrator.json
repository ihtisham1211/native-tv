  {
   "name": "settings an earlier build changed are put back and its snapshot dropped",
   "config": {
    "enabled": false,
    "snapshot": {
     "takenAt": 1700000000000,
     "settings": {
      "defaultApps": {
       "home": "com.webos.app.home"
      },
      "lastInputApp": "com.webos.app.hdmi2",
      "physicalLastInputApp": "com.webos.app.hdmi2"
     }
    }
   },
   "settings": {
    "defaultApps": {
     "home": "com.tvweb.home",
     "idleApp": "com.tvweb.home",
     "other": "x"
    },
    "lastInputApp": "com.tvweb.home",
    "physicalLastInputApp": "com.webos.app.hdmi1"
   },
   "steps": [
    {
     "start": true
    }
   ],
   "expect": {
    "events": [
     "read:defaultApps,lastInputApp,physicalLastInputApp",
     "write:{\"defaultApps\":{\"home\":\"com.webos.app.home\",\"other\":\"x\"},\"lastInputApp\":\"com.webos.app.hdmi2\"}",
     "legacy:installed?",
     "notice:off"
    ],
    "config": {
     "hideLgHomeAtStart": null,
     "snapshot": false
    }
   }
  },
