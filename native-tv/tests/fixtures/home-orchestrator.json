   "config": {
    "enabled": false
   },
   "steps": [
    {
     "start": true
    }
   ],
   "expect": {
    "events": [
     "read:defaultApps,lastInputApp,physicalLastInputApp",
     "legacy:installed?",
     "notice:off"
    ],
    "config": {
     "hideLgHomeAtStart": null,
     "snapshot": false
    }
   }
  },
